# -----------------------------------------------------------------------------
# Docker Compose — postgres service (docker-compose.yml)
# -----------------------------------------------------------------------------

# PostgreSQL superuser name (default local dev only).
POSTGRES_USER=postgres

# PostgreSQL password (default local dev only — change in shared environments).
POSTGRES_PASSWORD=postgres

# Database name created on first container start.
POSTGRES_DB=ecommerce

# -----------------------------------------------------------------------------
# Application (Prisma, Fastify API, scripts)
# -----------------------------------------------------------------------------

# Connection string for Prisma and the API. Must match POSTGRES_* above when using local Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# Redis URL for local Docker (not used by @upstash/redis in apps/api)
REDIS_URL=redis://localhost:6379

# Upstash REST API for API cache (apps/api) — optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Node environment: development | test | production
NODE_ENV=development
