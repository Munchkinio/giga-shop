# Copy to apps/api/.env or use repo root .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Upstash Redis REST API (optional — caching disabled if unset)
# Local Docker REDIS_URL does not work with @upstash/redis; use Upstash console credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
